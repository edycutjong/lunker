# Lunker — environment template. Copy to `.env` and fill in. `.env` is ignored.
#
# READ THIS FIRST. There are three different places a value can live and putting
# one in the wrong place is the mistake that matters:
#
#   1. Worker SECRETS  -> `wrangler secret put NAME` (encrypted at Cloudflare).
#                          NEVER in wrangler.toml, never in this repo.
#   2. Worker VARS     -> `[vars]` in worker/wrangler.toml. Non-secret ids only.
#   3. App PUBLIC vars -> `EXPO_PUBLIC_*`, compiled INTO the APK and readable by
#                          anyone who unzips it. Only ever public-by-design keys.
#
# This file exists for local CLI use (scripts/lunker-verify.mjs) and as the
# checklist of what a fresh clone needs. `npm run secrets` (gitleaks) will fail
# CI if a real value from group 1 ever lands in a commit.


# ── Worker secrets — `cd worker && npx wrangler secret put <NAME>` ───────────

# RevenueCat V2 SECRET key. Moves virtual currency for any customer.
# Get from: https://app.revenuecat.com -> your project -> Project Settings ->
#           API keys -> Secret keys -> "V2 secret key". Starts `sk_`.
REVENUECAT_SECRET_KEY=sk_replace_me

# Shared secret RevenueCat signs webhook bodies with. The purchase ledger that
# /verify renders accepts nothing that fails this HMAC.
# Get from: https://app.revenuecat.com -> Integrations -> Webhooks -> your
#           webhook -> "Authorization header value". Generate your own string;
#           `openssl rand -hex 32` is fine.
REVENUECAT_WEBHOOK_SECRET=replace_me

# OneSignal App API Key. Sent as `authorization: Key <value>`. Can push to every
# installed device, so it is server-only.
# Get from: https://dashboard.onesignal.com -> your app -> Settings -> Keys & IDs
#           -> "App API Key".
ONESIGNAL_REST_API_KEY=replace_me

# HMAC key every bite's roll seed derives from. Nothing external issues this —
# you generate it and it never leaves the Worker. Leaking it lets a player
# compute their fish before opening the push.
# Generate with: openssl rand -hex 32
# Rotating it re-rolls the FUTURE only; seeds already written to `sent` are
# fixed, so past catches stay reproducible.
ROLL_SERVER_SECRET=replace_me


# ── Worker vars — worker/wrangler.toml `[vars]`, not secrets ─────────────────

# RevenueCat project the virtual-currency transactions are scoped to.
# Get from: https://app.revenuecat.com -> Project Settings -> the `proj...` id
#           in the URL.
REVENUECAT_PROJECT_ID=replace_me

# OneSignal App ID (a UUID). Public — it also ships in the APK.
# Get from: https://dashboard.onesignal.com -> Settings -> Keys & IDs -> "App ID".
ONESIGNAL_APP_ID=replace_me

# Exposes POST /dev/cast, the on-demand bite trigger used while recording the
# demo video. It can only trigger the TIMING of a bite; the roll is live either
# way. Must be "0" in production.
DEV_CAST_ENABLED=0

# D1 database id, goes in wrangler.toml under [[d1_databases]].
# Get from: `npx wrangler d1 create lunker` — it prints the id.
D1_DATABASE_ID=replace_me


# ── App — compiled into the APK, public by design ───────────────────────────

# RevenueCat PUBLIC Android SDK key. Safe in the bundle; it cannot grant or
# spend currency, which is why every movement goes through the Worker.
# Get from: https://app.revenuecat.com -> Project Settings -> API keys -> the
#           Google Play app's public key. Starts `goog_`.
EXPO_PUBLIC_RC_ANDROID_KEY=goog_replace_me

# Same OneSignal App ID as above. Public by design.
EXPO_PUBLIC_ONESIGNAL_APP_ID=replace_me

# The deployed Worker's base URL. Also set in app/app.json under `expo.extra
# .workerUrl`, which is what the app actually reads; this is here for the CLIs.
LUNKER_WORKER_URL=https://lunker.example.workers.dev


# ── Local tooling only ──────────────────────────────────────────────────────

# Seed for the deterministic content emitter. Changing it changes the bytes of
# seed/content/*.json and will fail the CI determinism gate. Leave it alone
# unless that is the point of your change.
SEED=lunker-2026
